# Required
SECRET_KEY=change-me-to-a-long-random-string
ADMIN_EMAIL=chirchirlamec@gmail.com
ADMIN_PASSWORD_HASH=paste-the-output-of-the-hash-command
# Local testing over http only (leave unset in production)
# COOKIE_SECURE=0
# Production database: a Postgres connection string (Neon, Supabase, Render Postgres...).
# When this is set the app uses Postgres and ignores DATABASE_PATH.
# DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
# Local only: SQLite file used when DATABASE_URL is not set
# DATABASE_PATH=cashflow.db
# Set to 1 when behind a proxy so rate limiting sees the real visitor IP (automatic on Vercel)
# TRUST_PROXY=1

# Optional: automatic M-Pesa confirmation (Safaricom Daraja STK push)
# DARAJA_ENV=sandbox            # or production
# DARAJA_CONSUMER_KEY=
# DARAJA_CONSUMER_SECRET=
# DARAJA_SHORTCODE=             # your Till or Paybill number
# DARAJA_PASSKEY=
# DARAJA_TXN_TYPE=CustomerPayBillOnline   # or CustomerBuyGoodsOnline for a Till
# CALLBACK_BASE_URL=https://your-site.example
# CALLBACK_SECRET=a-long-random-string
